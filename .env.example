# BioNEET Pro — Environment Variables Template
# Copy to .env.local for local backend development (never commit .env.local).

# ==============================================================================
# 1. AI Tutor Gateway (OpenRouter / LLM Proxy)
# ==============================================================================
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_API_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_TOKENS=550

# ==============================================================================
# 2. Flask Web Server Configuration
# ==============================================================================
PORT=5000
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
# Reject request bodies larger than this (bytes). Prevents abuse of AI endpoints.
MAX_CONTENT_LENGTH_BYTES=262144

# Authentication mode — production FAILS CLOSED by default.
# Production: leave both unset (strict). Only verified Firebase ID tokens are
# honored; caller-supplied student_id is never trusted (401/403).
# Development (explicit opt-in ONLY): DEV_AUTH_MODE=true permits local
# body/query identity for runs and the dev test-suite.
# REQUIRE_FIREBASE_AUTH=false is a legacy explicit override (prefer DEV_AUTH_MODE).
DEV_AUTH_MODE=true
# REQUIRE_FIREBASE_AUTH=false

# ==============================================================================
# 3. Google Cloud / Firebase Admin SDK (Server-Side Persistence)
# Optional: without this, backend automatically uses local JSON files in data/
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ==============================================================================
# 4. Firebase Web Client Configuration (Frontend)
# Public client configuration for Firebase Auth and Cloud Firestore
# ==============================================================================
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Frontend link to Flask backend.
# Local dev: http://127.0.0.1:5000 (frontend auto-maps localhost:* to :5000).
# Production: the deployed HTTPS backend URL (never localhost — browsers would
# call their own machine). The frontend honors window.BIONEET_AI_BACKEND_URL
# first, then same-origin on deployed domains.
VITE_AI_BACKEND_URL=http://127.0.0.1:5000
VITE_ENABLE_DEMO_MODE=false
