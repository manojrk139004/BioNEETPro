VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
VITE_AI_BACKEND_URL=https://your-ai-tutor-backend.example.com
VITE_ENABLE_DEMO_MODE=true

OPENROUTER_API_KEY=replace-with-server-only-key
OPENROUTER_MODEL=openai/gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000,https://your-hosting-domain.example
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
FLASK_DEBUG=false
PORT=5000
# NOTE: never commit a real OPENROUTER_API_KEY. .env.local is git-ignored. Rotate any key that was ever committed.
