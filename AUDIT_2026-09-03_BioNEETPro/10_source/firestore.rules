rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow create: if ownsUid(userId) && request.resource.data.role == "student";
      allow read, update: if ownsUid(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow create, read, update: if ownsUid(userId);
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }

    match /mcqs/{mcqId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
